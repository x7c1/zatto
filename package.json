{
  "name": "zatto",
  "version": "0.0.1",
  "description": "GNOME Shell extension that lifts a window one or two layers behind the active one, without moving anything on screen",
  "main": "extension.js",
  "scripts": {
    "build": "tsc --build && node esbuild.config.js",
    "build:release": "BUILD_MODE=release tsc --build && BUILD_MODE=release node esbuild.config.js",
    "copy-files": "./scripts/copy-files.sh",
    "reload": "gdbus call --session --dest org.gnome.Shell --object-path /io/github/x7c1/Zatto --method io.github.x7c1.Zatto.Reload",
    "dev": "npm run build && npm run copy-files && npm run reload",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:strict": "biome check --error-on-warnings .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x7c1/zatto.git"
  },
  "keywords": [
    "gnome-shell-extension",
    "window-picker",
    "window-management"
  ],
  "author": "x7c1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/x7c1/zatto/issues"
  },
  "homepage": "https://github.com/x7c1/zatto#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@girs/adw-1": "4.9.0",
    "@girs/clutter-18": "4.9.0",
    "@girs/gdk-4.0": "4.9.0",
    "@girs/gjs": "4.9.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/gtk-4.0": "4.9.0",
    "@girs/meta-18": "4.9.0",
    "@girs/mtk-18": "4.9.0",
    "@girs/st-18": "4.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@girs/adw-1": "4.9.0",
    "@girs/cairo-1.0": "4.9.0",
    "@girs/clutter-18": "4.9.0",
    "@girs/cogl-2.0": "4.9.0",
    "@girs/freetype2-2.0": "4.9.0",
    "@girs/gdk-4.0": "4.9.0",
    "@girs/gio-2.0": "4.9.0",
    "@girs/gjs": "4.9.0",
    "@girs/glib-2.0": "4.9.0",
    "@girs/gmodule-2.0": "4.9.0",
    "@girs/gobject-2.0": "4.9.0",
    "@girs/graphene-1.0": "4.9.0",
    "@girs/gtk-4.0": "4.9.0",
    "@girs/meta-18": "4.9.0",
    "@girs/mtk-18": "4.9.0",
    "@girs/pango-1.0": "4.9.0",
    "@girs/shell-18": "4.9.0",
    "@girs/st-18": "4.9.0"
  },
  "dependencies": {
    "@haco-studio/gnome-licensing": "0.1.0-next.1"
  }
}
